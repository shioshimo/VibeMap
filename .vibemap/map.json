      "details": {
        "summary": "整个工具的核心逻辑层，无任何笨重的第三方依赖，启动仅需几十毫秒。",
        "deployLocation": "本机 Node.js 环境",
        "dependencies": [
          "node:http",
          "node:fs"
        ],
        "ports": [
          ":19527"
