    "src/core.js": {
      "title": "地图数据内核与文件校验器",
      "brief": "负责读写 .vibemap/map.json，并实时比对磁盘文件检测过期说明或新增文件",
      "details": {
        "summary": "扫描真实目录树并与 AI 写的说明合并，计算每个节点是「已同步」「代码已改待更新」「未写说明」还是「文件已删」。",
        "deployLocation": "本机进程",
        "dependencies": [
          "fs",
          "path"
        ],
        "ports": [],
        "debugTip": "如果想忽略特定缓存目录，在 IGNORED_NAMES 集合里添加名称。"
      },
      "snapshotMtime": 1794142979941.7102,
      "updatedAt": "2026-11-08T13:03:33.116Z",
      "updatedBy": "Antigravity"
    },
    "src/mcp.js": {
      "title": "通用 AI MCP 接口服务",
      "brief": "让 Claude Code、Codex、Antigravity、Cursor 等所有 AI 都能直接读写地图和弹窗",
      "details": {
        "summary": "基于标准 JSON-RPC 2.0 实现的 MCP Server，提供 vibemap_get_map、vibemap_upsert_folders、vibemap_update_architecture、vibemap_open_window 四个工具。",
        "deployLocation": "随 AI 客户端按需拉起 (stdio)",
        "dependencies": [
          "src/core.js",
          "src/launcher.js"
        ],
        "ports": [
          "stdio"
        ],
        "debugTip": "AI 更新后会自动通过 /api/notify 通知桌面窗口秒级刷新。"
      },
      "snapshotMtime": 1794141161886.9915,
      "updatedAt": "2026-11-08T13:03:33.116Z",
      "updatedBy": "Antigravity"
