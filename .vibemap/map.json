{
  "version": "1.0",
  "projectName": "VibeMap · 项目地图与架构白板系统",
  "purpose": "解决 Vibe Coding 代码写多了看不懂、维护难的问题。给所有 AI 配一张共享的「项目活地图」，AI 边写代码边维护地图，人随时打开就能看懂目录职责和整体架构。",
  "implementationSummary": "项目目录下保存结构化的 .vibemap/map.json；任何 AI 通过 MCP 协议或 CLI 读写地图；本地 Server 实时比对磁盘真实文件防止 AI 瞎编，并通过 SSE 实时渲染到独立桌面悬浮窗。",
  "techStack": [
    "Node.js",
    "MCP Protocol",
    "SSE 实时推送",
    ".NET 9 WebView2",
    "SVG Whiteboard"
  ],
  "updatedAt": "2026-11-08T13:03:33.121Z",
  "updatedBy": "Antigravity",
  "folderNodes": {
    ".": {
      "title": "VibeMap · AI 与人类共用的项目地图",
      "brief": "提供可逐层展开的文件夹地图、架构讲解白板、真实文件同步校验与通用 MCP 接口",
      "details": {
        "summary": "让 Vibe Coding 开发者不用翻代码也能一眼看懂项目结构和运行原理；所有 AI 通过 MCP 或 CLI 共享并持续维护同一份地图。",
        "deployLocation": "本机 Windows 独立桌面悬浮窗 + 本地服务 (:19527)",
        "dependencies": [
          "Node.js v24",
          ".NET 9 WebView2"
        ],
        "ports": [
          ":19527 (本地 UI 与热更新服务)",
          "stdio (MCP 协议)"
        ],
        "debugTip": "窗口打不开时运行 node src/cli.js open 即可自动拉起后台与桌面端。"
      },
      "snapshotMtime": 1794142503095.742,
      "updatedAt": "2026-11-08T13:03:33.116Z",
      "updatedBy": "Antigravity"
    },
